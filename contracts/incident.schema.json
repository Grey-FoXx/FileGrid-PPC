{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "incident",
  "type": "object",
  "properties": {
    "stationId": {
      "type": "string"
    },
    "zone": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "affectedCustomers": {
      "type": "integer",
      "minimum": 0
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "safetyCritical": {
      "type": "boolean"
    }
  },
  "required": [
    "stationId",
    "zone",
    "eventType",
    "severity"
  ]
}
